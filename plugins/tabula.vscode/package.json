{
  "name": "tabula",
  "displayName": "Tabula — CSV & Markdown Formulas",
  "description": "Run spreadsheet-style formulas inside CSV and Markdown files. Recompute on save.",
  "version": "0.2.23",
  "icon": "icon-128.png",
  "publisher": "tabula",
  "repository": {
    "type": "git",
    "url": "https://github.com/pblazh/tabula",
    "directory": "plugins/tabula.vscode"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Data Science",
    "Formatters",
    "Notebooks",
    "Other"
  ],
  "keywords": [
    "csv",
    "markdown",
    "tabula",
    "spreadsheet",
    "formulas",
    "datascience",
    "tables",
    "notes",
    "obsidian",
    "excel",
    "numbers",
    "calc",
    "notebook"
  ],
  "activationEvents": [
    "onLanguage:csv",
    "onLanguage:markdown"
  ],
  "main": "./out/main.js",
  "contributes": {
    "languages": [
      {
        "id": "tabula",
        "aliases": [
          "Tabula",
          "tabula"
        ],
        "extensions": [
          ".tbl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "csv",
        "aliases": [
          "CSV",
          "csv"
        ],
        "extensions": [
          ".csv"
        ],
        "mimetypes": [
          "text/csv"
        ]
      }
    ],
    "grammars": [
      {
        "language": "tabula",
        "scopeName": "source.tabula",
        "path": "./syntaxes/tabula.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "tabula.toggleAutoExecution",
        "title": "Toggle Auto-Execute on Save",
        "category": "Tabula"
      },
      {
        "command": "tabula.execute",
        "title": "Execute tabula on an opened file",
        "category": "Tabula"
      }
    ],
    "configuration": {
      "title": "Tabula",
      "properties": {
        "tabula.autoExecution": {
          "type": "boolean",
          "default": true,
          "description": "Automatically execute Tabula scripts when saving CSV or Markdown files"
        },
        "tabula.executablePath": {
          "type": "string",
          "default": "tabula",
          "description": "Path to the tabula executable. Use 'tabula' to use the version in your PATH, or specify an absolute path (e.g., '/usr/local/bin/tabula' or '/Users/username/bin/tabula')"
        },
        "tabula.autoFormat": {
          "type": "boolean",
          "default": true,
          "description": "Auto format output (adds -a flag to tabula command). When enabled, tabula will automatically format the output CSV."
        }
      }
    }
  },
  "scripts": {
    "prepackage": "npm run build",
    "pretest": "npm run build",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "tsc -watch -p ./",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "test": "vscode-test",
    "package": "mkdir dist ; vsce package -o ./dist/",
    "publish": "vsce publish",
    "publish:patch": "vsce publish patch",
    "publish:minor": "vsce publish minor",
    "publish:major": "vsce publish major"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.102.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.1",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.2.0",
    "obsidian": "latest",
    "ts-jest": "^29.4.6",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.56.0"
  }
}
